{
  "manifest_version": 3,
  "name": "UW MyPlan Auto-Register",
  "version": "0.1.0",
  "description": "Autofill SLNs on register.uw with conflict-group pruning (e.g. EE 344 > EE 280). Policy-compliant: you click Update Schedule.",
  "permissions": ["storage", "alarms", "tabs", "scripting", "notifications", "identity", "power"],
  "host_permissions": [
    "https://myplan.uw.edu/*",
    "https://register.uw.edu/*",
    "https://sdb.admin.uw.edu/*",
    "https://idp.u.washington.edu/*",
    "https://weblogin.washington.edu/*",
    "https://messages.google.com/*",
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "36331657050-fdes2hdm7a923h67s0dd1h44sdsonek0.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "popup/icon16.png",
    "48": "popup/icon48.png",
    "128": "popup/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "UW MyPlan Auto-Register",
    "default_icon": {
      "16": "popup/icon16.png",
      "48": "popup/icon48.png",
      "128": "popup/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://myplan.uw.edu/*"],
      "js": ["lib/uw.js", "lib/storage.js", "content/myplan.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://register.uw.edu/*",
        "https://sdb.admin.uw.edu/*"
      ],
      "js": ["lib/uw.js", "lib/storage.js", "content/register.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://idp.u.washington.edu/*",
        "https://weblogin.washington.edu/*"
      ],
      "js": ["lib/uw.js", "lib/storage.js", "content/weblogin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://messages.google.com/*"],
      "js": ["lib/uw.js", "lib/storage.js", "lib/notify.js", "content/messages.js"],
      "run_at": "document_idle"
    }
  ]
}
